{
  "name": "namibia-redesigned-gui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Redesigned ASKET mission cockpit (NODE branding: frosted glass + pattern). Reuses the functional layer of src/asket_gui without modifying it.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "vite build",
    "build:mock": "vite build --mode mock --outDir dist-mock --emptyOutDir",
    "preview": "vite preview",
    "preview:mock": "vite preview --outDir dist-mock",
    "dev:cloud": "vite --mode cloud",
    "build:cloud": "vite build --mode cloud --outDir dist-cloud --emptyOutDir",
    "preview:cloud": "vite preview --outDir dist-cloud"
  },
  "dependencies": {
    "maplibre-gl": "^5.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0"
  }
}
