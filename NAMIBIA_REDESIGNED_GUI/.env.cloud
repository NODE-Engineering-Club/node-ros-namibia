# Selected by `npm run build:cloud` / `npm run dev:cloud` (vite --mode cloud):
# the read-only cockpit fed from Azure Blob Storage (src/lib/azureTransport.js).
# No secrets here. The access token comes from the viewer link, or from the
# host's environment variables (VITE_AZURE_*), see cloud/azure/README.md.
VITE_SOURCE=azure
