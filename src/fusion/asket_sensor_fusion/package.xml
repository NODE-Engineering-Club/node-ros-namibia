<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asket_sensor_fusion</name>
  <version>0.1.0</version>
  <description>
    Dynamic sea-surface LiDAR filtering, SAM2-mask 3D obstacle extraction,
    and RTK-georeferenced EKF tracking for the ASKET ASV Kelp Blue mission.
    See "Mission controls and documents/" and
    ASKET-SPEC-PERCEPTION-SAM2-FUSION-v1.0.
  </description>
  <maintainer email="njord@stud.ntnu.no">Njord</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>libpcl-all-dev</depend>
  <depend>pcl_conversions</depend>
  <depend>eigen</depend>
  <!-- sensor_fusion_obstacle_node uses cv::Mat directly (not just via
       cv_bridge's own typedefs), so OpenCV is declared explicitly rather
       than relying on it only arriving transitively through cv_bridge's
       own apt Depends. -->
  <depend>libopencv-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
