<root BTCPP_format="4" main_tree_to_execute="MainTree">

  <!--
    MainTree for the ASKET ASV (Kelp Blue / Namibia).

    GlobalSafety is the only behaviour layer today: a bearing-only obstacle
    reflex that asks mission_manager for a temporary detour through
    /mission/set_bypass_target. It runs on every tick while a mission is
    active. Mission-specific subtrees for the Kelp mission set (survey-lane
    pause/hold, canopy keep-out, failsafe ladder, see
    "Mission controls and documents/KELP_MISSIONS.md" M2/M3/M7) slot in
    between GlobalSafety and MissionMonitor.
  -->
  <BehaviorTree ID="MainTree">
    <ReactiveSequence name="AsketMission">
      <WaitForOdom/>
      <SubTree ID="GlobalSafety"/>
      <MissionMonitor/>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="GlobalSafety">
    <Fallback name="OptionalGlobalCollisionAvoidance">
      <Sequence name="GlobalCollisionAvoidance">
        <CollisionRiskDetected/>
        <DetermineAvoidanceTarget/>
        <RequestAvoidance/>
      </Sequence>

      <AlwaysSuccess/>
    </Fallback>
  </BehaviorTree>

</root>
