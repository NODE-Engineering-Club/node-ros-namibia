<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>system_test</name>
  <version>0.1.0</version>
  <description>Built-in test: passive checks, active tests, GO/NO-GO verdict.</description>
  <maintainer email="node@example.org">NODE Engineering Club</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>asket_interfaces</depend>
  <depend>asket_common</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>omniscan_bridge</exec_depend>
  <!-- Also imported at run time, NOT declared: gui_backend (live_inputs parses
       the Pico STATE line with gui_backend.core.pico_state, the one parser for
       that format). gui_backend already depends on system_test, and declaring
       the reverse would be a dependency cycle colcon refuses. Both are always
       installed together (the GUI launch starts this node). -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
